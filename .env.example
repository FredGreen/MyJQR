# ===== MyJQR 环境变量（复制为 .env 后填写）=====
APP_ENV=dev
SECRET_JWT_PASSPHRASE=change-me

# 数据库 / 缓存（compose 内主机名；本机裸跑改成 localhost）
MYSQL_DSN=mysql+pymysql://root:myjqr_root@mysql:3306/writing?charset=utf8mb4
REDIS_URL=redis://redis:6379/0

# 模型（必填后生成功能才可用）
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# 博查搜索（可选：留空则跳过联网搜索）
BOCHA_API_KEY=

# 阿里云内容安全（可选：留空则放行并记日志）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 初始管理员（seeds 用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 业务配置
SIGNUP_GIFT_JOULE=100
MYSQL_ROOT_PASSWORD=myjqr_root
